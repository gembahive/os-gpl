# [image] verbose_boot: the kernel log and systemd's status on the panel, through the framebuffer console on the
# virtual terminal. tty0 is the last console=, so /dev/console; loglevel=7 and systemd.show_status=1 come after the
# boot loader's `loglevel=0 quiet` and override them. The panel's graphics client switches the terminal to graphics
# mode (KDSETMODE) when it takes the panel over.
CONFIG_CMDLINE="console=tty0 loglevel=7 systemd.show_status=1"
CONFIG_CMDLINE_EXTEND=y
CONFIG_FRAMEBUFFER_CONSOLE=y
# 40x28 characters on the 240x284 panel; the only font built in, so fbcon picks it.
CONFIG_FONTS=y
CONFIG_FONT_6x10=y
