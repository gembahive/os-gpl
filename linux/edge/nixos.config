# Options NixOS requires on top of arm64.defconfig (nixpkgs system.requiredKernelConfig, /etc overlay mounts).
# DMIID is omitted: arm64 DMI depends on EFI, which this board lacks.
# journald Forward Secure Sealing uses AF_ALG HMAC-SHA256.
CONFIG_CRYPTO_USER_API_HASH=y
CONFIG_CRYPTO_HMAC=y
# The firewall (networking.nftables): one inet table of stateless rules, so no connection tracking.
CONFIG_NETFILTER=y
CONFIG_NF_TABLES=y
CONFIG_NF_TABLES_INET=y
# EROFS (lz4hc) for the root and the /etc metadata image, with xattrs for overlayfs metacopy/redirect.
CONFIG_EROFS_FS=y
CONFIG_EROFS_FS_ZIP=y
CONFIG_EROFS_FS_XATTR=y
# The /etc metadata image is loop-mounted as the lower layer of an overlayfs.
CONFIG_BLK_DEV_LOOP=y
CONFIG_OVERLAY_FS=y
# The initrd is embedded zstd-compressed.
CONFIG_RD_ZSTD=y
# The boot loader's root= names the slot's partition, for the initrd's own use; NixOS's root=fstab, last, makes
# systemd mount / from the initrd's fstab instead.
CONFIG_CMDLINE="root=fstab"
CONFIG_CMDLINE_EXTEND=y
# No loadable modules (the default), stated for NixOS, which reads this file: its initrd then has no kmod and no
# modprobe sysctl.
# CONFIG_MODULES is not set
