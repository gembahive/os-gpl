# The dev profile's: our drivers as modules, loaded at boot, so a rebuilt one replaces the running one without a
# flash (rmmod, then insmod of the new .ko).
CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=y
CONFIG_DRM_ACCEL_AX620E_NPU=m
CONFIG_VIDEO_AX620E_VIN=m
CONFIG_VIDEO_AX620E_TDP=m
CONFIG_VIDEO_AX620E_JPEG=m
# LoadPin pins module and firmware reads to the first filesystem read from, the verified /nix; a pushed .ko is read
# from /tmp, so module reads go unpinned. Firmware stays pinned.
CONFIG_CMDLINE="loadpin.exclude=kernel-module"
CONFIG_CMDLINE_EXTEND=y
# Lockdown refuses unsigned modules, and with modules on it builds in module signing; the dev profile runs without it.
# CONFIG_SECURITY_LOCKDOWN_LSM is not set
