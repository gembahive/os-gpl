LT7911EXC bridge manager build hooks.

--- a/drivers/misc/Kconfig
+++ b/drivers/misc/Kconfig
@@ -456,6 +456,15 @@
 
 	  If unsure, say N.
 
+config LT7911_MANAGE
+	bool "Lontium LT7911EXC bridge manager"
+	depends on I2C && GPIOLIB && PROC_FS
+	select FW_LOADER
+	select REGMAP_I2C
+	help
+	  The LT7911EXC (USB-C DP Alt Mode to MIPI CSI-2) bridge's source
+	  state, EDID and firmware flash, under /proc/lt7911_info.
+
 config SRAM
 	bool "Generic on-chip SRAM driver"
 	depends on HAS_IOMEM
--- a/drivers/misc/Makefile
+++ b/drivers/misc/Makefile
@@ -48,3 +48,4 @@
 obj-$(CONFIG_LATTICE_ECP3_CONFIG)	+= lattice-ecp3-config.o
+obj-$(CONFIG_LT7911_MANAGE)	+= lt7911_manage.o
 obj-$(CONFIG_SRAM)		+= sram.o
 obj-$(CONFIG_SRAM_EXEC)		+= sram-exec.o
