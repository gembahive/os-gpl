+/* Whether the write lies within one of the ranges (start, count). */
+static bool mmc_blk_write_allowed(const struct property *ranges,
+				  struct request *req)
+{
+	const __be32 *cell = ranges->value;
+	unsigned int i, cells = ranges->length / sizeof(*cell);
+	u64 first = blk_rq_pos(req), end = first + blk_rq_sectors(req);
+
+	for (i = 0; i + 1 < cells; i += 2) {
+		u64 start = be32_to_cpu(cell[i]);
+
+		if (first < end && first >= start &&
+		    end <= start + be32_to_cpu(cell[i + 1]))
+			return true;
+	}
+	return false;
+}
