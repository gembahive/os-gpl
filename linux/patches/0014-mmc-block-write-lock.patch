 	md->area_type = area_type;
 
+	/*
+	 * gemba,writable-sectors on the host node: pairs of 32-bit cells, the
+	 * start and count of each range of 512-byte sectors writable on the
+	 * card. Writes elsewhere and the MMC ioctls are refused. /chosen
+	 * gemba,unlocked, set by the boot loader, leaves the card unlocked.
+	 */
+	if (IS_ENABLED(CONFIG_MMC_BLOCK_WRITE_LOCK) &&
+	    !of_property_present(of_chosen, "gemba,unlocked"))
+		md->writable = of_find_property(mmc_dev(card->host)->of_node,
+						"gemba,writable-sectors", NULL);
+
