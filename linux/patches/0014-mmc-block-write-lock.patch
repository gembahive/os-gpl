+	if (md->writable && op_is_write(req_op(req)) &&
+	    !mmc_blk_write_allowed(md->writable, req)) {
+		pr_warn_ratelimited("%s: write refused: sectors %llu+%u\n",
+				    md->disk->disk_name, blk_rq_pos(req),
+				    blk_rq_sectors(req));
+		return MMC_REQ_FAILED_TO_START;
