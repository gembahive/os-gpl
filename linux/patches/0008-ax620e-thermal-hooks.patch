AX620E thermal sensor Kconfig and build hooks.

--- a/drivers/thermal/Kconfig
+++ b/drivers/thermal/Kconfig
@@ -327,6 +327,12 @@
 	  cpufreq is used as the cooling device to throttle CPUs when the
 	  passive trip is crossed.

+config AX620E_THERMAL
+	bool "Axera AX620E temperature sensor"
+	depends on (ARCH_AXERA || COMPILE_TEST) && THERMAL_OF
+	help
+	  The die temperature sensor of the Axera AX620E family.
+
 config AIROHA_THERMAL
 	tristate "Airoha thermal sensor driver"
 	depends on ARCH_AIROHA || COMPILE_TEST
--- a/drivers/thermal/Makefile
+++ b/drivers/thermal/Makefile
@@ -38,6 +38,7 @@
 # platform thermal drivers
 obj-y				+= broadcom/
 obj-$(CONFIG_THERMAL_MMIO)		+= thermal_mmio.o
+obj-$(CONFIG_AX620E_THERMAL)	+= ax620e_thermal.o
 obj-$(CONFIG_AIROHA_THERMAL)	+= airoha_thermal.o
 obj-$(CONFIG_SPEAR_THERMAL)	+= spear_thermal.o
 obj-$(CONFIG_SUN8I_THERMAL)     += sun8i_thermal.o
